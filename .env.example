# ===== 安全 =====
# 生产环境请务必修改
JWT_SECRET=change-me-in-production
JWT_EXPIRES_HOURS=24

# ===== 数据库（MySQL，默认）=====
# 运行 backend/app.py 时会自动创建数据库 medical-assistant-master 并建表
DB_TYPE=mysql
DATABASE_NAME=medical-assistant-master
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=123456
# 如无 MySQL，可切换 SQLite 兜底（DB_TYPE=sqlite）：
# DB_TYPE=sqlite
# DATABASE_PATH=backend/data/medical-assistant-master.db

# ===== LLM（OpenAI 兼容接口）=====
# 留空 -> 内置离线兜底模式（无需任何密钥即可运行完整 RAG 流程）
# 示例: OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_BASE_URL=https://api.deepseek.com/v1
OPENAI_API_KEY=sk-xxx
OPENAI_CHAT_MODEL=deepseek-chat
# 向量化：留空 -> 内置确定性哈希向量（离线可用，无需下载模型）。
# DeepSeek 未提供 /embeddings 接口，请勿填写 deepseek-embedding；
# 如需真实语义向量，可填写本地模型名如 all-MiniLM-L6-v2（维度384）。
OPENAI_EMBED_MODEL=

# ===== RAG 参数 =====
CHUNK_SIZE=500
CHUNK_OVERLAP=50
TOP_K=5
EMBED_DIM=256
