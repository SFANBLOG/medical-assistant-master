# ===== 安全 =====
# 生产环境请务必修改
JWT_SECRET=change-me-in-production
# Token 有效期（小时）
JWT_EXP_HOURS=24

# ===== 数据库（MySQL，默认）=====
# 运行 backend/app.py 时会自动创建数据库 medical-assistant-master 并建表
DB_TYPE=mysql
DATABASE_NAME=medical-assistant-master
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=123456
# 如无 MySQL，可切换 SQLite 兜底（DB_TYPE=sqlite）。
# SQLite 库文件路径由 backend/utils/db.py 内部推导，无需配置。

# ===== 向量库（Milvus，首选；已取消 ChromaDB）=====
MILVUS_ENABLE=1
MILVUS_HOST=127.0.0.1
MILVUS_PORT=19530
# 本地未启动 Milvus 时的连接超时（秒），超时后自动降级到 NumpyStore
MILVUS_CONNECT_TIMEOUT=3

# ===== LLM（OpenAI 兼容接口）=====
# 留空 API_KEY -> 内置离线兜底模式（无需任何密钥即可跑完整 RAG 流程）
#
# ⚠️ 铁律：BASE_URL / API_KEY / CHAT_MODEL 必须来自**同一个网关**，禁止跨网关混搭。
# 典型事故：换了新 key 却没改 BASE_URL，新 key 打到旧网关 -> 401 authentication_error。
# 推荐使用 LLM_* 命名（本项目 canonical）；OPENAI_* 为历史命名，两套都兼容。
# 解析优先级：平台注入的「完整对」> .env 的「完整对」> 平台注入的「半套」。
# 校验方式：启动后访问 GET /api/llm/status 查看实际生效的网关与掩码密钥。
#
# 例 1）DeepSeek 官方
# LLM_BASE_URL=https://api.deepseek.com/v1
# LLM_API_KEY=sk-xxx
# LLM_CHAT_MODEL=deepseek-chat
#
# 例 2）传智 tokenhub（推理型模型，思考过程也计入 token，故预算需给足）
LLM_BASE_URL=https://tokenhub.itcast.cn/v1
LLM_API_KEY=sk-xxx
LLM_CHAT_MODEL=deepseek-v4-flash

# 单次补全预算：token 上限与超时（秒）。推理型模型建议 >= 4096 / >= 180。
LLM_MAX_TOKENS=4096
LLM_TIMEOUT=180

# 向量化：本地模型目录（data/ai_models/bge-base-zh-v1.5，先运行 python download_model.py），
# 或 HuggingFace 模型 id（BAAI/bge-base-zh-v1.5，自动从 hf-mirror.com 下载）。
# auto -> 自动在模型目录下探测；留空 -> 内置确定性哈希向量（离线可用，语义检索效果差）。
OPENAI_EMBED_MODEL=auto

# ===== RAG 参数 =====
# EMBED_DIM 必须与向量模型维度一致：bge-base-zh-v1.5 = 768（bge-large-zh-v1.5 = 1024）
EMBED_DIM=768
# 切片大小（字符）
CHUNK_SIZE=500
CHUNK_OVERLAP=80
# 是否把「章节路径」拼到 chunk 文本前（如「第3章 糖尿病 > 3.1 分型」）
CHUNK_HEADING_PREFIX=1
TOP_K=5
MIN_SIMILARITY=0.30

# ===== 服务端口 =====
# PocketBay 等平台会注入 PORT，gunicorn 会优先读取
BACKEND_PORT=8010
