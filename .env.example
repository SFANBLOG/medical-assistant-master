# ===== 安全 =====
# 生产环境请务必修改
JWT_SECRET=change-me-in-production
JWT_EXPIRES_HOURS=24

# ===== 数据库（MySQL，默认）=====
# 运行 backend/app.py 时会自动创建数据库 medical-assistant-master 并建表
DB_TYPE=mysql
DATABASE_NAME=medical-assistant-master
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=123456
# 如无 MySQL，可切换 SQLite 兜底（DB_TYPE=sqlite）：
# DB_TYPE=sqlite
# DATABASE_PATH=backend/data/medical-assistant-master.db

# ===== 向量库（Milvus，首选；已取消 ChromaDB）=====
MILVUS_ENABLE=1
MILVUS_HOST=127.0.0.1
MILVUS_PORT=19530
MILVUS_DB=default
MILVUS_COLLECTION=

# ===== LLM（OpenAI 兼容接口）=====
# 留空 -> 内置离线兜底模式（无需任何密钥即可运行完整 RAG 流程）
# 示例: OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_BASE_URL=https://api.deepseek.com/v1
OPENAI_API_KEY=sk-xxx
OPENAI_CHAT_MODEL=deepseek-chat
# 向量化：本地模型目录（data/models/bge-base-zh-v1.5，先运行 python download_model.py），
# 或 HuggingFace 模型 id（BAAI/bge-base-zh-v1.5，自动从 hf-mirror.com 下载）。
# 留空 -> 内置确定性哈希向量（离线可用，无需下载模型，但语义检索效果差）。
OPENAI_EMBED_MODEL=data/models/bge-base-zh-v1.5

# ===== RAG 参数 =====
EMBED_DIM=768
CHUNK_SIZE=500
CHUNK_OVERLAP=80
TOP_K=5
MIN_SIMILARITY=0.30
