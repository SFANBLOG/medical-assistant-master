# ===== 安全 =====
# 生产环境请务必修改
JWT_SECRET=change-me-in-production
JWT_EXPIRES_HOURS=24

# ===== 数据库（MySQL，默认）=====
# 运行 backend/app.py 时会自动创建数据库 medical-assistant-master 并建表
DB_TYPE=mysql
DATABASE_NAME=medical-assistant-master
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=123456
# 如无 MySQL，可切换 SQLite 兜底（DB_TYPE=sqlite）：
# DB_TYPE=sqlite
# DATABASE_PATH=backend/data/medical-assistant-master.db

# ===== 向量库（Milvus，首选；已取消 ChromaDB）=====
MILVUS_ENABLE=1
MILVUS_HOST=127.0.0.1
MILVUS_PORT=19530
MILVUS_DB=default
MILVUS_COLLECTION=

# ===== LLM（OpenAI 兼容接口）=====
# 留空 -> 内置离线兜底模式（无需任何密钥即可运行完整 RAG 流程）
# 示例: OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_BASE_URL=https://api.deepseek.com/v1
OPENAI_API_KEY=sk-xxx
OPENAI_CHAT_MODEL=deepseek-chat
# 向量化：本地模型目录（data/ai_models/bge-base-zh-v1.5，先运行 python download_model.py），
# 或 HuggingFace 模型 id（BAAI/bge-base-zh-v1.5，自动从 hf-mirror.com 下载）。
# 留空 -> 内置确定性哈希向量（离线可用，无需下载模型，但语义检索效果差）。
OPENAI_EMBED_MODEL=data/models/bge-base-zh-v1.5

# ===== RAG 参数 =====
# EMBED_DIM 必须与向量模型维度一致：bge-base-zh-v1.5 = 768（bge-large-zh-v1.5 = 1024）
EMBED_DIM=768
# 切片大小（字符）：bge-* 最长 512 token，中文约 1 字/token，取 380 字符避免超长截断、召回更精准
CHUNK_SIZE=380
CHUNK_OVERLAP=60
TOP_K=6
MIN_SIMILARITY=0.30
# 检索提问指令前缀：bge-*-zh-v1.5 官方推荐不加（实测无前缀相似度更高）。
# 若使用 bge-large-zh（非 v1.5）请设为：为这个句子生成表示以用于检索相关文章：
QUERY_PREFIX=
# 检索提问是否启用关键词扩展变体（多向量 max-pool 提升召回）
QUERY_EXPAND=1
