# ===================== 医智助手 后端配置示例 =====================
# 复制为 .env 后按需修改；已存在的环境变量不会被覆盖。

# ---- 数据库（MySQL 优先；本机无 MySQL 时设 DB_TYPE=sqlite 自动回退）----
DB_TYPE=mysql
DATABASE_NAME=medical-assistant-master
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=123456

# ---- 向量库（Milvus 优先；未启动时自动降级 NumpyStore，取消 ChromaDB）----
MILVUS_ENABLE=1
MILVUS_HOST=127.0.0.1
MILVUS_PORT=19530
MILVUS_COLLECTION=medical_chunks

# ---- 大模型 / 向量化（OpenAI 兼容接口）----
OPENAI_BASE_URL=https://api.deepseek.com/v1
OPENAI_API_KEY=sk-xxx
OPENAI_CHAT_MODEL=deepseek-chat

# 嵌入模型：BAAI 官方中文语义检索模型（维度 768）
# 首次使用运行：cd backend && python download_model.py（自动下载到 data/models/）
# 也可直接填 HF id：BAAI/bge-base-zh-v1.5
# 若模型不可用，系统自动回退到确定性哈希向量（离线可用，但语义效果较弱）。
OPENAI_EMBED_MODEL=data/models/bge-base-zh-v1.5
EMBED_DIM=768

# 查询指令前缀（仅本地 BGE 类模型生效）：BGE 要求查询前加「为检索表示：」、
# 文档不加，相似度才正确。远程嵌入接口 / 哈希兜底模式留空或不影响。
QUERY_PREFIX=为检索表示：

# ---- RAG 切分 / 检索参数（中文医学文档调优推荐值）----
CHUNK_SIZE=500
CHUNK_OVERLAP=80
TOP_K=5
MIN_SIMILARITY=0.30

# ---- 服务 / 安全 ----
SECRET_KEY=medical-assistant-change-me
JWT_EXPIRE_HOURS=12
API_PORT=8010
DEMO_PASSWORD=demo123
