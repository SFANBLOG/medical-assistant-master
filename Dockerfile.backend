# 医智助手 · 后端镜像
# 运行方式：gunicorn wsgi:app （wsgi.py 位于项目根目录）
FROM python:3.11-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

# 编译期系统依赖（pymilvus / grpcio 等可能需要）
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    && rm -rf /var/lib/apt/lists/*

# 先装依赖以利用分层缓存
COPY backend/requirements.txt ./backend/requirements.txt
RUN pip install --no-cache-dir -r backend/requirements.txt

# 复制后端代码与 gunicorn 入口
COPY backend/ ./backend/
COPY wsgi.py ./wsgi.py

# 上传目录由 docker-compose 挂载为 volume，这里确保父目录存在
RUN mkdir -p /app/backend/data/uploads

EXPOSE 8010

# gunicorn 绑定 0.0.0.0:8010；wsgi:app 为已实例化的 Flask 应用
CMD ["gunicorn", "--bind", "0.0.0.0:8010", "--workers", "4", "--threads", "2", "--timeout", "120", "wsgi:app"]
