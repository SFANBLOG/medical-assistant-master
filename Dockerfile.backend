# 医智助手 · 后端镜像
# 运行方式：gunicorn wsgi:app （wsgi.py 位于项目根目录）
FROM python:3.11-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

# PyPI 镜像源：默认用阿里云（国内约 400KB/s，官方源在部分网络下仅 ~15KB/s，
# 能让依赖安装从 40+ 分钟降到几分钟）。海外环境可覆盖：
#   docker compose build --build-arg PIP_INDEX_URL=https://pypi.org/simple backend
ARG PIP_INDEX_URL=https://mirrors.aliyun.com/pypi/simple/

# 编译期系统依赖（pymilvus / grpcio 等可能需要）
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    && rm -rf /var/lib/apt/lists/*

# 先装依赖以利用分层缓存
# 坑：镜像自带 pip(24.x) 解析不了新版 numpy 的 metadata，会报
# "Could not find a version that satisfies the requirement numpy>=1.24.0 (from versions: none)"，
# 必须先升级 pip 再安装依赖。
COPY backend/requirements.txt ./backend/requirements.txt
COPY backend/requirements-ocr.txt ./backend/requirements-ocr.txt
RUN pip install --no-cache-dir --upgrade pip -i ${PIP_INDEX_URL}
RUN pip install --no-cache-dir --retries 3 --timeout 120 -r backend/requirements.txt -i ${PIP_INDEX_URL}

# OCR（扫描件 / 图片识别）默认关闭：onnxruntime + opencv 约 200MB 且构建慢，
# 非 headless 的 opencv-python 在 slim 镜像里 import cv2 还会缺 libxcb/libGL。
# 需要时构建：docker build --build-arg INSTALL_OCR=true ...
ARG INSTALL_OCR=false
RUN if [ "$INSTALL_OCR" = "true" ]; then \
        pip install --no-cache-dir --retries 3 --timeout 60 \
            -r backend/requirements-ocr.txt -i ${PIP_INDEX_URL} \
        && pip uninstall -y opencv-python \
        && pip install --no-cache-dir --no-deps opencv-python-headless ; \
    fi

# 容器内真实语义向量（BGE）默认关闭：torch CPU 轮约 800MB + sentence-transformers，
# 构建耗时长、镜像体积翻倍。默认走内置确定性哈希向量（零依赖、离线可用、不报错）。
# 需要时构建：docker compose build --build-arg INSTALL_LOCAL_EMBED=true backend
ARG INSTALL_LOCAL_EMBED=false
RUN if [ "$INSTALL_LOCAL_EMBED" = "true" ]; then \
        pip install --no-cache-dir --retries 3 --timeout 120 \
            torch --index-url https://download.pytorch.org/whl/cpu \
        && pip install --no-cache-dir --retries 3 --timeout 120 sentence-transformers -i ${PIP_INDEX_URL} ; \
    fi

# 复制后端代码与 gunicorn 入口
COPY backend/ ./backend/
COPY wsgi.py ./wsgi.py

# 上传目录由 docker-compose 挂载为 volume，这里确保父目录存在
RUN mkdir -p /app/backend/data/uploads

EXPOSE 8010

# gunicorn 绑定 0.0.0.0:8010；wsgi:app 为已实例化的 Flask 应用
# --preload 必需：wsgi.py 在导入时执行 init_database()（建库建表 + 播种 241 篇文档）。
# 不加 --preload 时 4 个 worker 会各自导入一次，并发重复播种导致主键冲突/重复数据；
# 加 --preload 后由 master 进程导入一次，再 fork 出 worker，初始化只跑一遍。
CMD ["gunicorn", "--preload", "--bind", "0.0.0.0:8010", "--workers", "4", "--threads", "2", "--timeout", "120", "wsgi:app"]
