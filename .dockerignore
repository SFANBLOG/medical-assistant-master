# 避免把本地环境/大文件塞进 docker 构建上下文
backend/.venv
backend/__pycache__
backend/**/__pycache__
backend/crash_trace.log
backend/seed_run.log
backend/logs

# 本地运行产生的状态文件：不要把宿主机的数据库/向量缓存带进镜像
backend/data/*.db
backend/data/numpy_store.pkl

# ⚠️ 只排除项目根目录的说明文档，绝对不要写成 *.md：
#    backend/data/uploads 下 241 篇知识库文档全部是 .md，用 *.md 会把整个知识库
#    从镜像里抹掉，容器启动后 seed 找不到任何文档，知识库为空（不报错但功能缺失）。
/*.md

# ⚠️ 以下两项必须保留在镜像内，不要加进来：
#   backend/data/uploads —— 241 篇知识库文档，seed_documents_and_vectors() 从中播种
#   backend/data/models  —— 离线 BGE 向量模型，打进镜像后容器无需联网下载

frontend/node_modules
frontend/dist
frontend/.venv
.git
.gitignore
.idea
**/*.pyc
